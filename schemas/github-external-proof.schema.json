{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://7thsense.github.io/fireweed/schemas/github-external-proof.schema.json",
  "title": "Fireweed GitHub external proof (P13a)",
  "description": "Run-owned external GitHub required-check / ruleset proof. Emitted by P13b, re-queried by P20. Repository-side schema and verifier owned by P13a.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "repository_id",
    "ruleset",
    "required_contexts",
    "candidate_source",
    "checks",
    "response_digests",
    "recorded_at"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "fireweed.github_external_proof.v1"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable GitHub repository node/database id (not display name)."
    },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "required_contexts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "candidate_source": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Immutable execution SHA S."
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workflow_id",
          "context",
          "check_suite_id",
          "check_run_id",
          "conclusion",
          "head_sha",
          "attempt"
        ],
        "properties": {
          "workflow_id": { "type": "string", "minLength": 1 },
          "context": { "type": "string", "minLength": 1 },
          "check_suite_id": { "type": "string", "minLength": 1 },
          "check_run_id": { "type": "string", "minLength": 1 },
          "conclusion": {
            "type": "string",
            "enum": ["success"]
          },
          "head_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "type": "string",
            "enum": ["completed"]
          }
        }
      }
    },
    "response_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ruleset", "check_runs"],
      "properties": {
        "ruleset": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "check_runs": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "recorded_at": {
      "type": "string",
      "minLength": 1,
      "description": "ISO-8601 timestamp of proof emission (informational; freshness is state-based)."
    },
    "snorri_external_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional Snorri external-acceptance injection bound into the composite product-ready proof.",
      "required": ["schema", "source_revision", "suite_id", "conclusion", "evidence_digest"],
      "properties": {
        "schema": {
          "type": "string",
          "const": "fireweed.snorri_external_acceptance.v1"
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "suite_id": { "type": "string", "minLength": 1 },
        "conclusion": {
          "type": "string",
          "enum": ["success"]
        },
        "evidence_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "product_release_readiness_claimed": {
      "type": "boolean",
      "description": "True only when live ruleset enforcement and successful required checks are proven."
    }
  }
}
