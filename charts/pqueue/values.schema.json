{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "pqueue Helm chart values",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "service",
    "containerPort",
    "resources",
    "probes",
    "config",
    "storage",
    "persistence"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "pullPolicy",
        "tag"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "create",
        "annotations",
        "name"
      ],
      "properties": {
        "create": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "podAnnotations": {
      "type": "object"
    },
    "podLabels": {
      "type": "object"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "port",
        "annotations"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "resources": {
      "type": "object"
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liveness",
        "readiness"
      ],
      "properties": {
        "liveness": {
          "$ref": "#/$defs/probe"
        },
        "readiness": {
          "$ref": "#/$defs/probe"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listenAddr",
        "principalId",
        "tenants"
      ],
      "properties": {
        "listenAddr": {
          "type": "string",
          "pattern": "^[^:]+:[0-9]+$"
        },
        "principalId": {
          "type": "string",
          "minLength": 1
        },
        "tenants": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lakebase",
        "shardCount",
        "log",
        "projection",
        "volume"
      ],
      "properties": {
        "lakebase": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "endpointMode",
            "databaseName",
            "port",
            "sslMode",
            "auth"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "endpointMode": {
              "type": "string",
              "enum": [
                "pooler",
                "direct"
              ]
            },
            "databaseName": {
              "type": "string",
              "minLength": 1
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "sslMode": {
              "type": "string",
              "enum": [
                "require"
              ]
            },
            "auth": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "existingSecret",
                "databricksHostKey",
                "databaseInstanceNameKey",
                "clientIdKey",
                "clientSecretKey",
                "tokenKey",
                "postgresUserKey"
              ],
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "native-password",
                    "service-principal-oauth",
                    "pat-oauth"
                  ]
                },
                "existingSecret": {
                  "type": "string"
                },
                "databricksHostKey": {
                  "type": "string",
                  "minLength": 1
                },
                "databaseInstanceNameKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientIdKey": {
                  "type": "string",
                  "minLength": 1
                },
                "clientSecretKey": {
                  "type": "string",
                  "minLength": 1
                },
                "tokenKey": {
                  "type": "string",
                  "minLength": 1
                },
                "postgresUserKey": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "shardCount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "integer",
              "minimum": 1
            },
            "max": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "log": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "objectLog",
            "postgres"
          ],
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "postgres",
                "objectlog"
              ]
            },
            "objectLog": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "root"
              ],
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "postgres": {
              "$ref": "#/$defs/postgresSecret"
            }
          }
        },
        "projection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "backend",
            "sqlite",
            "postgres"
          ],
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "inmemory",
                "sqlite",
                "postgres"
              ]
            },
            "sqlite": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "postgres": {
              "$ref": "#/$defs/postgresSecret"
            }
          }
        },
        "volume": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mountPath"
          ],
          "properties": {
            "mountPath": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "existingClaim",
        "storageClass",
        "accessModes",
        "size",
        "annotations"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingClaim": {
          "type": "string"
        },
        "storageClass": {
          "type": "string"
        },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "string",
          "minLength": 1
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    }
  },
  "$defs": {
    "postgresSecret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "existingSecret",
        "databaseUrlKey"
      ],
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "databaseUrlKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "initialDelaySeconds",
        "periodSeconds",
        "timeoutSeconds",
        "failureThreshold"
      ],
      "properties": {
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
